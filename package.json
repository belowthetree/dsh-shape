{
  "name": "@belowthetree/dsh-shape",
  "version": "0.4.18",
  "type": "module",
  "description": "A DeepSeek Harness plugin that adds a dynamic lightweight extension form for customizing DSH UI and functionality.",
  "license": "MIT",
  "author": "belowthetree",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shape",
    "agent-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belowthetree/dsh-shape.git"
  },
  "homepage": "https://github.com/belowthetree/dsh-shape#readme",
  "bugs": {
    "url": "https://github.com/belowthetree/dsh-shape/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tools": "./tools.js",
    "./skill": "./skill.js",
    "./capabilities": "./src/capabilities.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "skill.js",
    "cordis.patch.yml",
    "src/capabilities.ts",
    "shapes/**",
    "skills/**",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
