{
  "name": "dsh-shape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A DeepSeek Harness plugin for rapidly customizing DSH UI and functionality with folder-based shapes.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tools": "./tools.js",
    "./skill": "./skill.js",
    "./capabilities": "./src/capabilities.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "skill.js",
    "cordis.patch.yml",
    "src/capabilities.ts",
    "shapes/**",
    "skills/**",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
